---
import Base from '../../layouts/Base.astro';
import Home from '../../components/Home.astro';
import { defaultLang, langs, type Lang } from '../../data/profile';

// El español vive en la raíz; el resto de idiomas en /en/, /fr/ y /pt/.
export function getStaticPaths() {
  return langs.filter((lang) => lang !== defaultLang).map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
---
<Base lang={lang}>
  <Home lang={lang} />
</Base>
