---
import { profile, type Lang } from '../data/profile';
import { useTranslations } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---
<section id="home" class="hero">
  <div class="container hero-grid">
    <div class="hero-copy">
      <p class="eyebrow">{profile.eyebrow[lang]}</p>
      <h1>{profile.headline[lang]}</h1>
      <p class="lede">{profile.lede[lang]}</p>
      <div class="actions">
        <a class="button" href="#contact">{t('hero.cta')} <span aria-hidden="true">→</span></a>
        <a class="button ghost" href="#projects">{t('hero.secondary')}</a>
      </div>
    </div>
    <figure class="portrait">
      <div class="frame"><img src={profile.photo} alt={`${profile.name}, ${profile.jobTitle[lang]}`} width="420" height="420" fetchpriority="high" /></div>
      <figcaption>
        <strong>{profile.name}</strong>
        <span>{profile.jobTitle[lang]}</span>
      </figcaption>
    </figure>
  </div>
  <div class="container">
    <dl class="stats">
      {profile.stats.map((s) => (
        <div>
          <dt>{s.label[lang]}</dt>
          <dd>{s.value}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<section id="about" class="section">
  <div class="container split">
    <div>
      <p class="kicker">{t('nav.about')}</p>
      <h2>{t('about.title')}</h2>
    </div>
    <div class="prose">
      {profile.about[lang].map((p) => <p>{p}</p>)}
    </div>
  </div>
  <div class="container">
    <h3 class="subhead">{t('about.pillars')}</h3>
    <ol class="pillars">
      {profile.pillars.map((p, i) => (
        <li>
          <span class="num" aria-hidden="true">0{i + 1}</span>
          <h4>{p.title[lang]}</h4>
          <p>{p.text[lang]}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<section id="projects" class="section alt">
  <div class="container">
    <p class="kicker">{t('nav.projects')}</p>
    <h2>{t('projects.title')}</h2>
    <div class="ventures">
      {profile.ventures.map((v) => (
        <article class="venture">
          <p class="venture-role">{v.role[lang]}</p>
          <h3>{v.url ? <a href={v.url}>{v.name}</a> : v.name}</h3>
          <p>{v.description[lang]}</p>
          <p class="result">{v.result[lang]}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<section id="experience" class="section">
  <div class="container split">
    <div>
      <p class="kicker">{t('nav.experience')}</p>
      <h2>{t('experience.title')}</h2>
    </div>
    <div>
      <ol class="timeline">
        {profile.experience.map((e) => (
          <li>
            <span class="period">{e.period}</span>
            <div>
              <h3>{e.role[lang]} <span class="at">· {e.company}</span></h3>
              <p>{e.highlight[lang]}</p>
            </div>
          </li>
        ))}
      </ol>
      <h3 class="subhead">{t('experience.education')}</h3>
      <ul class="education">
        {profile.education.map((e) => (
          <li><strong>{e.title[lang]}</strong><span>{e.school}</span></li>
        ))}
      </ul>
    </div>
  </div>
</section>

<section id="contact" class="section contact">
  <div class="container">
    <p class="kicker">{t('nav.contact')}</p>
    <h2>{t('contact.title')}</h2>
    <p class="lede">{t('contact.text')}</p>
    <a class="button light" href={`mailto:${profile.email}`}>{t('contact.cta')} <span aria-hidden="true">→</span></a>
    <p class="email">{profile.email}</p>
    <p class="social">
      {t('contact.social')}{' '}
      {profile.links.map((l, i) => (
        <>{i > 0 && ' · '}<a href={l.url} rel="me noopener">{l.label}</a></>
      ))}
    </p>
  </div>
</section>
